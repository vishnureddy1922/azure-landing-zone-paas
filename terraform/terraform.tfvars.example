prefix      = "alz"
environment = "dev"
location    = "eastus2"
owner       = "platform-team"
alert_email = "you@example.com"

# Your public IP, so `terraform apply` can write the TLS certificate to Key Vault.
admin_ip_ranges = ["203.0.113.10/32"]

# Microsoft Entra ID group that administers Azure SQL (Entra-only auth, no SQL passwords).
sql_admin_group_name      = "sg-alz-sql-admins"
sql_admin_group_object_id = "00000000-0000-0000-0000-000000000000"

# Cost switches
enable_firewall     = false
enable_app_gateway  = true
enable_geo_dr       = true
enable_backup_vault = true
enable_policy       = true
